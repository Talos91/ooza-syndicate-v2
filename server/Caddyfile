# Caddy on the room server (/etc/caddy/Caddyfile): TLS, /ooze -> relay.py, the rest = the server's build (the test link).
# Installed by server/deploy.sh --relay when it differs (validated first; a reload closes open WebSockets).
45-32-126-20.sslip.io {
	encode gzip
	handle /ooze* {
		reverse_proxy 127.0.0.1:8765
	}
	handle {
		root * /opt/ooze/web
		header /index.html Cache-Control "no-cache"
		file_server
	}
}
