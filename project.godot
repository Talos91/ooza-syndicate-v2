; Engine configuration file.
; Ooze Syndicate 2.0 - fresh project (design authority: Docs/Game Design/Ooze Syndicate 2.0/).

config_version=5

[application]

config/name="Ooze Syndicate 2.0"
run/max_fps=60
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.008, 0.01, 0.014, 1)
boot_splash/image="res://assets/art/ui/boot_logo.png"
boot_splash/use_filter=true

[audio]

; 0.23.4 (Daniele's phone, Android Chrome: the SOUND TEST beeps play, the game effects never - Godot's web SAMPLE chain
; put out a signal 15x over full scale with a DC offset; desktop read 0.02): web effects play as STREAMS, mixed in wasm and
; sent through the AudioWorklet, which read clean on his phone. 0 = Stream, 1 = Sample (the web template's default).
general/default_playback_type.web=0

[autoload]

Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
